{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.cjs",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/warn-secrets.cjs",
        "failClosed": false
      }
    ]
  }
}
